# Copy this file to .env before running docker-compose

POSTGRES_USER=ezitech
POSTGRES_PASSWORD=ezitech_pass
POSTGRES_DB=ezitech_ai020
POSTGRES_PORT=5432

# Used by the backend container (host "db" = the postgres service name below)
DATABASE_URL=postgresql://ezitech:ezitech_pass@db:5432/ezitech_ai020

# Day 4: sentence-transformers model used by the embedding pipeline.
# Optional — defaults to all-MiniLM-L6-v2 if unset.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Day 17: lightweight MLflow model-version tracking (success-probability
# model). All optional — defaults below use a local file store, so
# tracking works out of the box with no separate MLflow server. Point
# MLFLOW_TRACKING_URI at a real server's URI (e.g. http://mlflow:5000) if
# one is ever stood up; nothing else in the app needs to change.
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=success-probability-model
MLFLOW_TRACKING_ENABLED=true

# Day 18: comma-separated CORS allowlist for a hosted deployment.
# "*" (default) is fine for local dev; a hosted demo should set this to
# the actual deployed dashboard origin(s), e.g.
# ALLOWED_ORIGINS=https://ai020-dashboard.onrender.com
ALLOWED_ORIGINS=*
