# Copy this file to .env before running docker-compose

POSTGRES_USER=ezitech
POSTGRES_PASSWORD=ezitech_pass
POSTGRES_DB=ezitech_ai020
POSTGRES_PORT=5432

# Used by the backend container (host "db" = the postgres service name below)
DATABASE_URL=postgresql://ezitech:ezitech_pass@db:5432/ezitech_ai020
